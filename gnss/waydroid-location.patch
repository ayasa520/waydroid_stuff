+// The property describes a stationary or moving position, not a recorded fix.
+// Read it for each sample so changes also reach the AIDL batching path.
+static void applyWaydroidPosition(GnssLocation& location) {
+    char value[PROPERTY_VALUE_MAX];
+    if (property_get("persist.waydroid.fake_gps", value, nullptr) <= 0) return;
+    std::vector<std::string> fields;
+    ParseUtils::splitStr(value, ',', fields);
+    if (fields.size() < 8 || fields[0] != "Fix" || fields[1] != "gps") return;
+
+    // Accept the original eight-field format as well as complete GNSS Logger
+    // rows. Accuracy and clocks are supplied by the live GNSS provider.
+    auto number = [&](size_t field) {
+        const char* first = fields[field].c_str();
+        char* end;
+        double result = std::strtod(first, &end);
+        return end != first && *end == '\0' ? result : NAN;
+    };
+    const double latitude = number(2), longitude = number(3), altitude = number(4);
+    const double speed = number(5), bearing = number(7);
+    if (!(std::abs(latitude) <= 90 && std::abs(longitude) <= 180 &&
+          std::isfinite(altitude) && speed >= 0 && speed <= std::numeric_limits<float>::max() &&
+          bearing >= 0 && bearing <= 360)) return;
+    location.latitudeDegrees = latitude;
+    location.longitudeDegrees = longitude;
+    location.altitudeMeters = altitude;
+    location.speedMetersPerSec = speed;
+    location.bearingDegrees = bearing;
+}
